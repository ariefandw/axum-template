# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
RUST_LOG=axum_template=debug,tower_http=debug

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/axum_template_db
DATABASE_MAX_CONNECTIONS=20

# JWT Auth Secret
JWT_SECRET=super-secret-production-random-key-at-least-32-chars-long
JWT_EXPIRATION_HOURS=24

# Rate Limiter
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST_SIZE=40

# Social Auth (OAuth2)
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=mock_github_client_id
GITHUB_CLIENT_SECRET=mock_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:3000/api/v1/auth/github/callback
