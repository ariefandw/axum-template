# ---------------------------------------------------------------------------
# Environment
# `production` makes the safety gates mandatory: it refuses to start without an
# encryption key, an explicit CORS allowlist, a metrics token, and TLS-capable
# SMTP. Development defaults are convenient and deliberately cannot leak into a
# production deployment.
# ---------------------------------------------------------------------------
APP_ENV=development

# --- Server ---------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
RUST_LOG=axum_template=debug,tower_http=info
REQUEST_TIMEOUT_SECONDS=30
BODY_LIMIT_BYTES=10485760

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/axum_template_db
DATABASE_MAX_CONNECTIONS=20

# --- Auth -----------------------------------------------------------------
# Signs access tokens. Minimum 32 characters.
JWT_SECRET=super-secret-production-random-key-at-least-32-chars-long
# Access tokens are short-lived because revocation lives in the sessions table.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Per-account lockout, complementing the per-IP auth rate limit.
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=15

# Argon2id. Defaults are the OWASP minimum; raise memory first when tuning.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# --- Encryption at rest ---------------------------------------------------
# Seals third-party OAuth tokens. REQUIRED in production; derived from
# JWT_SECRET in development. Generate with: openssl rand -base64 32
# Rotating this makes previously stored provider tokens unreadable.
# ENCRYPTION_KEY=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST_SIZE=40
# Credential endpoints get a much tighter bucket.
AUTH_RATE_LIMIT_PER_SECOND=1
AUTH_RATE_LIMIT_BURST_SIZE=10
# Enable ONLY behind a proxy you control. When true, X-Forwarded-For decides
# the rate-limit bucket and the audit trail's client IP, so an untrusted caller
# could otherwise choose both.
TRUST_PROXY_HEADERS=false

# --- CORS -----------------------------------------------------------------
# Comma-separated. Empty means "any origin", which production refuses.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# --- Observability --------------------------------------------------------
# Bearer token guarding /metrics. REQUIRED in production.
# METRICS_TOKEN=

# --- Idempotency ----------------------------------------------------------
IDEMPOTENCY_TTL_SECONDS=86400

# --- Storage --------------------------------------------------------------
# local | s3
#
# `local` keeps bytes on this container's disk: fine for development and single
# node, but a file written by one replica is invisible to the others and is lost
# when the container is replaced. Use `s3` for anything horizontally scaled.
STORAGE_BACKEND=local

# Used by the `local` backend. Mount it as a volume in any real deployment.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
SIGNED_URL_TTL_SECONDS=900
# Enforced against the sniffed content type, not the supplied filename.
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,application/json

# --- Object storage (required when STORAGE_BACKEND=s3) --------------------
# Works with AWS S3 and with S3-compatible services (Cloudflare R2, MinIO,
# Wasabi, regional providers). A partial configuration is refused at startup
# rather than silently falling back to local disk.
# AWS_BUCKET=my-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Set for non-AWS providers; omit for AWS itself.
# AWS_ENDPOINT=https://s3.example.com
# Non-AWS providers almost always need path-style addressing.
# AWS_USE_PATH_STYLE_ENDPOINT=true
# Optional key namespace, so one bucket can host several environments safely.
# AWS_KEY_PREFIX=production

# --- Mail -----------------------------------------------------------------
# REQUIRED in production: without it, account-recovery mail is silently dropped.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@localhost.local
# TLS cannot be disabled in production.
SMTP_TLS=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# --- Social auth (optional; set all three per provider or none) -----------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost:3000/api/v1/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URL=http://localhost:3000/api/v1/auth/callback/github
