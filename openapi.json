      "get": {
        "tags": [
          "Social Login"
        ],
        "operationId": "github_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "OAuth authorization code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "CSRF state token",
            "required": false,
            "schema": {
              "type": "string"
            }
