  "components": {
    "schemas": {
      "ApiErrorPayload": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "description": "Standardized Error Envelope",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorPayload"
          },
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiResponse_AuthResponse": {
        "type": "object",
        "description": "Standardized Success Envelope",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "access_token",
              "token_type",
              "expires_in",
              "user"
            ],
            "properties": {
              "access_token": {
                "type": "string"
              },
              "expires_in": {
                "type": "integer",
                "format": "int64"
              },
              "token_type": {
                "type": "string"
              },
              "user": {
                "$ref": "#/components/schemas/UserResponse"
              }
            }
          },
          "meta": {},
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiResponse_OAuthUrlResponse": {
        "type": "object",
        "description": "Standardized Success Envelope",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "url",
              "csrf_token"
            ],
            "properties": {
              "csrf_token": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "meta": {},
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiResponse_String": {
        "type": "object",
        "description": "Standardized Success Envelope",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "data": {
            "type": "string"
          },
          "meta": {},
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiResponse_UploadResponse": {
        "type": "object",
        "description": "Standardized Success Envelope",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "original_filename",
              "stored_filename",
              "content_type",
              "size_bytes",
              "url"
            ],
            "properties": {
              "content_type": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "original_filename": {
                "type": "string"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stored_filename": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "meta": {},
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiResponse_UserResponse": {
        "type": "object",
        "description": "Standardized Success Envelope",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "name",
              "email",
              "email_verified",
              "role",
              "created_at"
            ],
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "email": {
                "type": "string"
              },
              "email_verified": {
                "type": "boolean"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "image": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          },
          "meta": {},
          "success": {
            "type": "boolean"
          }
        }
      },
      "ApiResponse_Vec_UserResponse": {
        "type": "object",
        "description": "Standardized Success Envelope",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "email",
                "email_verified",
                "role",
                "created_at"
              ],
              "properties": {
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "email": {
                  "type": "string"
                },
                "email_verified": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "image": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "meta": {},
          "success": {
            "type": "boolean"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64"
          },
          "token_type": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "CursorMeta": {
        "type": "object",
        "description": "Standard Cursor-Based Metadata for Envelope",
        "required": [
          "limit",
          "has_next"
        ],
        "properties": {
          "has_next": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
